FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            codedFixedValue;
        value           uniform 0;
        name            localizedTracerInlet;

        code
        #{
            const vectorField& centres = this->patch().Cf();

            scalarField tracer(centres.size(), 0.0);

            forAll(centres, i)
            {
                if (centres[i].y() >= 0.0 && centres[i].y() <= 0.005)
                {
                    tracer[i] = 1.0;
                }
            }

            operator==(tracer);
        #};
    }

    outlet
    {
        type            zeroGradient;
    }

    upperWall
    {
        type            zeroGradient;
    }

    lowerWall
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}

